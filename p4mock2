    <!-- JavaScript Logic -->
    <script>
        function checkAnswers() {
            let totalMarks = 0;
            const inputs = document.querySelectorAll('input[data-answer]');
            
            inputs.forEach(input => {
                const userAns = input.value.trim().toLowerCase();
                const expectedAnsList = input.getAttribute('data-answer').toLowerCase().split('|');
                
                // Remove existing status indicators if any
                let badge = input.nextElementSibling;
                if (badge && badge.classList.contains('answer-badge')) {
                    badge.remove();
                }
                
                const isCorrect = expectedAnsList.some(ans => ans === userAns);

                badge = document.createElement('span');
                badge.className = 'answer-badge text-xs font-bold px-1.5 py-0.5 rounded ml-1 inline-block ';

                if (isCorrect && userAns !== "") {
                    badge.className += 'bg-emerald-100 text-emerald-800 border border-emerald-300';
                    badge.innerText = '✓';
                    totalMarks += (input.id.startsWith('ans-b') || input.id.startsWith('ans-c') || input.id.startsWith('ans-d')) ? 2 : (input.id.startsWith('ans-e') ? 3 : 1);
                } else {
                    badge.className += 'bg-rose-100 text-rose-800 border border-rose-300';
                    badge.innerText = `✗ (${expectedAnsList[0]})`;
                }

                input.parentNode.insertBefore(badge, input.nextSibling);
            });

            document.getElementById('current-score').innerText = totalMarks;
        }

        function toggleAnswerKey() {
            const sampleWriting = document.getElementById('sample-writing');
            const btn = document.getElementById('btn-toggle-key');
            
            if (sampleWriting.classList.contains('hidden')) {
                sampleWriting.classList.remove('hidden');
                btn.classList.add('bg-amber-600', 'hover:bg-amber-700');
                btn.classList.remove('bg-indigo-600', 'hover:bg-indigo-700');
                
                // Fill in inputs with answer key values if empty
                document.querySelectorAll('input[data-answer]').forEach(input => {
                    const firstAnswer = input.getAttribute('data-answer').split('|')[0];
                    if (!input.value) {
                        input.value = firstAnswer;
                    }
                });
            } else {
                sampleWriting.classList.add('hidden');
                btn.classList.remove('bg-amber-600', 'hover:bg-amber-700');
                btn.classList.add('bg-indigo-600', 'hover:bg-indigo-700');
            }
        }

        function resetForm() {
            document.querySelectorAll('input[type="text"], textarea').forEach(el => el.value = '');
            document.querySelectorAll('.answer-badge').forEach(el => el.remove());
            document.getElementById('current-score').innerText = '__';
            document.getElementById('sample-writing').classList.add('hidden');
        }
    </script>
